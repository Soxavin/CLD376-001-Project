# Copy to scripts/.env (gitignored) and fill in your Atlas details.
# Same cluster, different database name at the end of each URI.
MONGO_URI_AUTH=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/auth_db?retryWrites=true&w=majority
MONGO_URI_CATALOG=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/catalog_db?retryWrites=true&w=majority
