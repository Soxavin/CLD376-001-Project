PORT=3007
INSTANCE_NAME=billing
# Must end with the database name: billing_db
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/billing_db?retryWrites=true&w=majority
# Billing calls Work Orders through the gateway's PRIVATE address (EC2-1)
GATEWAY_INTERNAL_URL=http://<EC2-1 private IP>:3000
# TEMPORARY: while Work Orders doesn't exist yet, set to true to use a fixed fake work order.
# Remove (or set to false) once the real Work Orders service is running.
WORK_ORDERS_STUB=false
# With the stub on: "completed" (default) or "in_progress" to rehearse test N11
WORK_ORDERS_STUB_STATUS=completed
