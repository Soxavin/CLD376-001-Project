PORT=3002
INSTANCE_NAME=login
# Must end with the database name: auth_db (shared with Registration)
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/auth_db?retryWrites=true&w=majority
# Same value as the gateway's JWT_SECRET (32+ random characters)
JWT_SECRET=replace-me-with-32-plus-random-characters
