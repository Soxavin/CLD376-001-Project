# Used ONLY by docker-compose.dev.yml (copy this file to .env in the repo root; .env is gitignored).
# Do not put quotes around values.

# From Atlas: mongodb+srv://<ATLAS_USER>:<ATLAS_PASSWORD>@<ATLAS_HOST>/...
# Use a password with letters and numbers only. Characters like @ : / # ? $ break the connection string.
ATLAS_USER=your-atlas-username
ATLAS_PASSWORD=your-atlas-password
ATLAS_HOST=cluster0.xxxxx.mongodb.net

# 64 characters from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be shared with the whole team: the gateway and Login need the same value.
JWT_SECRET=replace-me-with-the-64-character-secret
