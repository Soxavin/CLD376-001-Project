PORT=3000
INSTANCE_NAME=api-gateway
JWT_SECRET=PASTE_THE_64_CHARACTER_SECRET
# Same instance as the gateway -> compose service names
REGISTRATION_URL=http://registration:3001
LOGIN_URL=http://login:3002
# Other instances -> PRIVATE IPs (they survive a Learner Lab restart; public IPs don't)
BOOKING_URL=http://<EC2-2 private IP>:3003
VEHICLES_URL=http://<EC2-2 private IP>:3004
WORK_ORDERS_URL=http://<EC2-2 private IP>:3005
NOTES_URL=http://<EC2-3 private IP>:3006
BILLING_URL=http://<EC2-3 private IP>:3007
# The two Service Catalog replicas the gateway round-robins between (A on EC2-2, B on EC2-3)
CATALOG_URLS=http://<EC2-2 private IP>:3008,http://<EC2-3 private IP>:3008
