PORT=3007
INSTANCE_NAME=billing
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER_HOST/billing_db?retryWrites=true&w=majority
# Billing calls Work Orders through the gateway (EC2-1 PRIVATE IP)
GATEWAY_INTERNAL_URL=http://<EC2-1 private IP>:3000
# Keep false on EC2 once the real Work Orders service is deployed
WORK_ORDERS_STUB=false
WORK_ORDERS_STUB_STATUS=completed
